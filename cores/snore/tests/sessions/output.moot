// Container look still invokes inherited description and the contents hook.
; move(#107, #111); move(#114, #111); #111.description = {"A box.", "With a lid."}; add_verb(#111, {player, "rxd", "tell_contents"}, {"this", "none", "this"}); set_verb_code(#111, "tell_contents", {"pass(@args);", "player:tell(\"Contents hook ran.\");"}); #111:set_opened(true); player.output_batches = {}; #111:look_self(); return {length(player.output_batches), player.output_batches[1], sort($string_utils:explode(player.output_batches[2], "\n")), player.output_batches[3]};
{3, "A box.\nWith a lid.", {"  baseline thing", "  bronze orb", "Contents:"}, "Contents hook ran."}
