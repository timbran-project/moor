~~Alpha alpha
; return $note_editor:insertion(player in $note_editor.active);
2
% /alpha/c1
~~Alpha alpha
% find /alpha/c
~~beta ALPHA
; return $note_editor:insertion(player in $note_editor.active);
3
% find /absent/1
=`absent' not found.
; return {$note_editor:insertion(player in $note_editor.active), $note_editor:changed(player in $note_editor.active)};
{3, false}
