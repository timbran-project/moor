  override aliases (owner: HACKER, flags: "rc") = {"Mr. Spell", "spell"};
  override description (owner: HACKER, flags: "rc") = "For help on using the speller, use 'help spelling' and 'help @spell'.";
  override object_size (owner: HACKER, flags: "r") = {1298817, 1084848672};

  method description owner: HACKER
    "Return the dictionary description and entry count.";
    return this.description + " There are " + tostr(this.entries) + " words in the online dictionary.";
  endmethod

  method valid owner: HACKER
    "Return whether a word exists in the shared or personal dictionary.";
    return this:find_exact(args[1]) != $failed_match || args[1] in player.dict;
  endmethod

  method get_input owner: #2
    "Read a property, verb, or literal text with caller authority for spelling checks.";
    let thing;
    let prop;
    set_task_perms(caller_perms());
    const source = args[1];
    let data = {};
    let ref = $code_utils:parse_propref(source);
    if (ref)
      "User entered a prop. Deal with it.";
      {thing, prop} = ref;
      thing = $string_utils:match_object(thing, player.location);
      if (!valid(thing))
        player:tell("No such object: ", ref[1]);
        data = $failed_match;
      elseif (!prop || `thing.(tostr(prop)) ! ANY' == E_PROPNF)
        player:tell("There is no such property `", prop, "' on object ", thing, ".");
        data = $failed_match;
      else
        data = `thing.(tostr(prop)) ! ANY';
        if (typeof(data) == TYPE_STR)
          data = {data};
        endif
        $command_utils:suspend_if_needed(3);
        if (typeof(data) == TYPE_ERR)
          player:tell("Error: ", tostr(data));
          data = $failed_match;
        elseif (typeof(data) != TYPE_LIST)
          player:tell("Spellchecker needs a string or list as input.");
          data = $failed_match;
        endif
      endif
    else
      ref = $code_utils:parse_verbref(source);
      if (ref)
        "User entered a verb. Deal with it.";
        {thing, verb} = ref;
        thing = $string_utils:match_object(thing, player.location);
        if (!valid(thing))
          player:tell("No such object: ", ref[1]);
          data = $failed_match;
        elseif (`verb_info(thing, verb) ! ANY' == E_VERBNF)
          player:tell("There is no such verb `", verb, "' on object ", thing, ".");
          data = $failed_match;
        else
          data = `verb_code(thing, verb) ! ANY => {}';
          for i in [1..length(data)]
            if (!index(data[i], "\""))
              data[i] = "";
            else
              data[i] = data[i][index(data[i], "\"") + 1..$];
              data[i] = data[i][1..rindex(data[i], "\"") - 1];
              let foo = "";
              while (index(data[i], "\""))
                foo = foo + data[i][1..index(data[i], "\"") - 1];
                foo = foo + " ";
                data[i] = data[i][index(data[i], "\"") + 1..$];
                data[i] = data[i][index(data[i], "\"") + 1..$];
              endwhile
              if (foo == "")
                foo = data[i];
              else
                foo = foo + data[i];
              endif
              data[i] = $string_utils:trim(foo);
            endif
          endfor
        endif
      else
        "User entered word/phrase on command line.";
        data = {argstr};
      endif
    endif
    for i in [1..length(data)]
      $command_utils:suspend_if_needed(1);
      if (typeof(data[i]) != TYPE_STR)
        data[i] = "";
      endif
      data[i] = $string_utils:strip_chars(data[i], "!@#$%^&*()_+1234567890={}[]`<>?:;,./|\"~'");
    endfor
    return data;
  endmethod

  method guess_words owner: HACKER
    "Return sorted dictionary suggestions from spelling edits.";
    let foo;
    let nastyword = args[1];
    let guesses = {};
    "Transpose adjacent characters";
    nastyword = nastyword + " ";
    for i in [1..length(nastyword) - 1]
      foo = nastyword[1..i - 1] + nastyword[i + 1] + nastyword[i] + nastyword[i + 2..$];
      foo = $string_utils:trim(foo);
      if (this:valid(foo))
        guesses = listappend(guesses, foo);
      endif
      if (ticks_left() < 500 || seconds_left() < 2)
        suspend(0);
      endif
    endfor
    nastyword = $string_utils:trim(nastyword);
    "Erase each character - check for an extra typoed character";
    for i in [1..length(nastyword)]
      foo = nastyword[1..i - 1] + nastyword[i + 1..$];
      if (this:valid(foo))
        guesses = listappend(guesses, foo);
      endif
      if (ticks_left() < 500 || seconds_left() < 2)
        suspend(0);
      endif
    endfor
    "Alter one character";
    for i in [1..length(nastyword)]
      for ii in ({"a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l", "m", "n", "o", "p", "q", "r", "s", "t", "u", "v", "w", "x", "y", "z", "'", "-"})
        foo = nastyword[1..i - 1] + ii + nastyword[i + 1..$];
        if (this:valid(foo))
          guesses = listappend(guesses, foo);
        endif
      endfor
      if (ticks_left() < 500 || seconds_left() < 2)
        suspend(0);
      endif
    endfor
    "insert one character";
    for i in [1..length(nastyword)]
      for ii in ({"a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l", "m", "n", "o", "p", "q", "r", "s", "t", "u", "v", "w", "x", "y", "z", "'", "-"})
        foo = nastyword[1..i - 1] + ii + nastyword[i..$];
        if (this:valid(foo))
          guesses = listappend(guesses, foo);
        endif
      endfor
      if (ticks_left() < 500 || seconds_left() < 2)
        suspend(0);
      endif
    endfor
    "Get some close matches from the database verbs themselves";
    foo = this:find_all(nastyword);
    if (foo != TYPE_ERR)
      if (foo != $failed_match && foo != $ambiguous_match)
        if (length(foo) < 6)
          for i in (foo)
            guesses = listappend(guesses, i);
          endfor
        endif
      endif
    endif
    "Clean up and go home";
    guesses = $list_utils:remove_duplicates(guesses);
    guesses = $list_utils:sort(guesses);
    return guesses;
  endmethod

  method _find_index owner: HACKER
    "Index of a word in the case-insensitively sorted .words list, or 0.";
    const key = $string_utils:lowercase(args[1]);
    let lo = 1;
    let hi = length(this.words);
    while (lo <= hi)
      const mid = (lo + hi) / 2;
      const probe = $string_utils:lowercase(this.words[mid]);
      probe == key && return mid;
      if (strcmp(probe, key) < 0)
        lo = mid + 1;
      else
        hi = mid - 1;
      endif
    endwhile
    return 0;
  endmethod

  method _lower_bound owner: HACKER
    "First index whose lowercase word is >= args[1], or length + 1.";
    const key = $string_utils:lowercase(args[1]);
    let lo = 1;
    let hi = length(this.words);
    let result = hi + 1;
    while (lo <= hi)
      const mid = (lo + hi) / 2;
      if (strcmp($string_utils:lowercase(this.words[mid]), key) >= 0)
        result = mid;
        hi = mid - 1;
      else
        lo = mid + 1;
      endif
    endwhile
    return result;
  endmethod

  method find_exact owner: HACKER
    ":find_exact(word) => the dictionary spelling for word, or $failed_match.";
    if (ticks_left() < 1000 || seconds_left() < 3)
      suspend(0);
    endif
    const i = this:_find_index(args[1]);
    return i ? this.words[i] | $failed_match;
  endmethod

  method find_all owner: HACKER
    ":find_all(prefix) => dictionary spellings beginning with prefix.";
    if (ticks_left() < 1000 || seconds_left() < 3)
      suspend(0);
    endif
    const needle = $string_utils:lowercase(args[1]);
    const start = this:_lower_bound(needle);
    const n = length(this.words);
    let matches = {};
    let i = start;
    while (i <= n)
      const word = this.words[i];
      index($string_utils:lowercase(word), needle) == 1 || return matches;
      matches = {@matches, word};
      i = i + 1;
      if (ticks_left() < 500 || seconds_left() < 2)
        suspend(0);
      endif
    endwhile
    return matches;
  endmethod

  method sort owner: HACKER
    "sort({x1,x3,x2},{1,3,2}) => {x1,x2,x3}";
    let use_sorted_lst;
    let sorted_keys;
    const lst = args[1];
    const unsorted_keys = (use_sorted_lst = length(args) >= 2) ? args[2] | lst;
    let sorted_lst = sorted_keys = {};
    for e in (unsorted_keys)
      const l = $list_utils:find_insert(sorted_keys, e);
      sorted_keys = listinsert(sorted_keys, e, l);
      if (use_sorted_lst)
        sorted_lst = listinsert(sorted_lst, lst[length(sorted_keys)], l);
      endif
      if (ticks_left() < 500 || seconds_left() < 2)
        suspend(0);
      endif
    endfor
    return sorted_lst || sorted_keys;
  endmethod

  method add_word owner: HACKER
    ":add_word(string) -- adds word to the spell database";
    "Returns true iff this word wasn't already there.";
    const cp = caller_perms();
    if (caller == this || (cp in this.trusted || $perm_utils:controls(cp, this)))
      this:_find_index(args[1]) && return false;
      this.words = listinsert(this.words, args[1], this:_lower_bound(args[1]));
      this.entries = this.entries + 1;
      return true;
    else
      return E_PERM;
    endif
  endmethod

  method remove_word owner: HACKER
    ":remove_word(string) -- removes word from the spell database";
    "Returns true iff word was actually there to be removed.";
    const cp = caller_perms();
    if (caller == this || (cp in this.trusted || $perm_utils:controls(cp, this)))
      const i = this:_find_index(args[1]);
      i || return false;
      this.words = listdelete(this.words, i);
      this.entries = this.entries - 1;
      return true;
    else
      return E_PERM;
    endif
  endmethod

  method submit owner: HACKER
    ":submit(word) -- add a word to this.submitted";
    this.submitted = {@this.submitted, args[1]};
  endmethod

  method purge_entire_database owner: HACKER
    "$spell:purge_entire_database - a nasty verb that will zap the whole dictionary.";
    "usage: eval $spell:purge_entire_database()     ";
    !($perm_utils:controls(caller_perms(), this) || caller == this) && return E_PERM;
    !player.wizard && return E_PERM;
    player:tell("WARNING: This will ERASE all the entries in the online dictionary! IF YOU ARE SURE YOU WISH TO DO THIS, TYPE `PURGE' NOW. Any other input with abort the command.");
    const input = $command_utils:read();
    if (input != "purge")
      player:tell("ABORTED. Database left as is.");
    else
      this.words = {};
      this.entries = 0;
    endif
  endmethod

  method random owner: HACKER
    "returns a random word from the dictionary. maybe useful for games and things";
    "that need a unique word. accepts no arguments.";
    let word = "";
    while (word == "")
      const x = random(26);
      const y = random(26);
      if (seconds_left() < 2)
        suspend(0);
      endif
      const lettera = $string_utils.alphabet[x];
      const letterb = $string_utils.alphabet[y];
      const foo = $spell:find_all(lettera + letterb);
      if (foo != {})
        word = foo[random($)];
      endif
    endwhile
    return word;
  endmethod

  verb help_msg (none none none) owner: HACKER flags: "rxd"
    "Return the dictionary's help description.";
    return this.description;
  endverb

  method init_for_core owner: #2
    "Reset this object for an extracted core. Wizard callers only.";
    !caller_perms().wizard && return;
    pass(@args);
    $spell.trusted = {};
  endmethod

  verb "clear-submitted" (none on this) owner: HACKER flags: "rxd"
    "Clear dictionary submissions when the player is trusted.";
    if (!(player in this.trusted))
      player:tell("Sorry, you can't do that.");
      return E_PERM;
    endif
    this.submitted = {};
    player:tell("$spell.submitted = {};");
  endverb

  method proxy_for_core owner: #2
    "Keep this dictionary object during extraction.";
    return this;
  endmethod
endobject
