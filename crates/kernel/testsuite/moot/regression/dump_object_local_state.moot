@wizard
; return load_object({"object #9000", "parent: #-1", "owner: #3", "property title (owner: #3, flags: \"rw\") = \"Hello\";", "property case_value (owner: #3, flags: \"rw\") = \"Hello\";", "property annotated (owner: #3, flags: \"rc\") = 1;", "endobject"});
#9000

; return load_object({"object #9001", "parent: #9000", "owner: #3", "endobject"});
#9001

; #9001.title = "Hello"; #9001.case_value = "hello"; set_property_metadata(#9001, "annotated", "note", "local metadata");

// Dump committed state, then import it onto a new child of the same parent.
; add_property(#0, "dump_state", dump_object(#9001), {player, ""});

; return load_object(#0.dump_state, ["target" -> #9002]);
#9002

; #9000.title = "Changed"; #9000.case_value = "Changed"; #9000.annotated = 2;

; return {#9002.title, #9002.case_value, is_clear_property(#9002, "title"), is_clear_property(#9002, "case_value"), #9002.annotated, is_clear_property(#9002, "annotated"), property_metadata(#9002, "annotated", "note")};
{"Hello", "hello", 0, 0, 2, 1, "local metadata"}

// Merge a clear export over a stale local value, retaining its metadata.
; #9002.annotated = 99;

; return load_object(#0.dump_state, ["target" -> #9002]);
#9002

; return {#9002.annotated, is_clear_property(#9002, "annotated"), property_metadata(#9002, "annotated", "note")};
{2, 1, "local metadata"}

// Replacement restores a clear inherited value with metadata over a local value.
; #9002.annotated = 99; return reload_object(#0.dump_state, ["target" -> #9002]);
#9002

; return {#9002.annotated, is_clear_property(#9002, "annotated"), property_metadata(#9002, "annotated", "note")};
{2, 1, "local metadata"}

// A constant and a program variable named clear still work.
; return load_object({"define clear = 42;", "object #9002", "parent: #9000", "owner: #3", "override annotated = clear;", "method clear owner: #3", "clear = 7; return clear;", "endmethod", "endobject"});
#9002

; return {#9002.annotated, #9002:clear()};
{42, 7}

; return load_object({"object #9002", "parent: #9000", "owner: #3", "override annotated (owner: #3, flags: \"r\") [note -> \"updated\"] clear;", "endobject"});
#9002

; return {#9002.annotated, is_clear_property(#9002, "annotated"), property_info(#9002, "annotated"), property_metadata(#9002, "annotated", "note")};
{2, 1, {#3, "r"}, "updated"}

// Both dump modes must see pending creations, metadata, values, and programs.
; const o = load_object({"object #9010", "owner: #3", "property value (owner: #3, flags: \"rw\") = 1;", "verb test (this none this) owner: #3 flags: \"rxd\"", "return 1;", "endverb", "endobject"});
> set_object_metadata(o, "import_export_id", "pending_dump"); o.value = 42; set_verb_code(o, "test", {"return 42;"});
> const literal = dump_object(o); const symbolic = dump_object(o, ["constants" -> true]);
> return {index(toliteral(literal), "42") > 0, index(toliteral(symbolic), "PENDING_DUMP") > 0, index(toliteral(symbolic), "42") > 0};
{1, 1, 1}

// Source dumps omit only baseline annotations and do not change stored metadata.
; set_verb_metadata(#9010, "test", "objdef_base", ["marker" -> 1]); set_verb_metadata(#9010, "test", "note", "kept");
> const full = toliteral(dump_object(#9010)); const source = toliteral(dump_object(#9010, ["include_baselines" -> false, "constants" -> true]));
> return {index(full, "objdef_base") > 0, index(source, "objdef_base"), index(source, "kept") > 0, index(source, "PENDING_DUMP") > 0, verb_metadata(#9010, "test", "objdef_base")};
{1, 0, 1, 1, ["marker" -> 1]}

; return `dump_object(#9010, ["include_baselines" -> "no"]) ! E_TYPE => 1';
1

; return `dump_object(#9010, ["include_baselines" -> false, 'INCLUDE_BASELINES -> true]) ! E_INVARG => 1';
1
