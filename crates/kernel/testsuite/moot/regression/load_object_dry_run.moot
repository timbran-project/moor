#9000

; return load_object({
> "object #9001 [revision -> 1]",
> "name: \"Original\"", "parent: #9000", "owner: #3", "readable: true",
> "property value (owner: #3, flags: \"rc\") [revision -> 1] = 1;",
> "verb test (this none this) owner: #3 flags: \"rxd\" [revision -> 1]",
> "return 1;", "endverb", "endobject"});
#9001

; add_property(#0, "dry_run_source", {
> "object #9001 [revision -> 2]",
> "name: \"Incoming\"", "parent: #-1", "owner: #4", "location: #9000", "wizard: true",
> "property value (owner: #4, flags: \"rw\") [revision -> 2] = 2;",
> "property added (owner: #3, flags: \"rc\") = 20;",
> "verb test (this none this) owner: #4 flags: \"rxd\" [revision -> 2]",
> "return 2;", "endverb",
> "verb added (this none this) owner: #3 flags: \"rxd\"",
> "return 20;", "endverb", "endobject"}, {player, "rc"});

// The call and earlier unrelated writes commit together. Inspect the next task's state.
; #9001.value = 7; const result = load_object(#0.dry_run_source, ["conflict_mode" -> "detect"]);
> let values = {};
> for conflict in (result[2])
>   if (conflict[2][1] == "property_value") values = {@values, conflict[2][3]}; endif
> endfor
> return {!result[1], values, result[3]};
{1, {7}, {#9001}}

; return {#9001.name, parent(#9001), #9001.owner, #9001.location, #9001.wizard, #9001.r, #9001.value, object_metadata(#9001, "revision"), property_metadata(#9001, "value", "revision"), verb_metadata(#9001, "test", "revision"), #9001:test(), properties(#9001), verbs(#9001)};
{"Original", #9000, #3, #-1, 0, 1, 7, 1, 1, 1, 1, {"value"}, {"test"}}

; return {property_info(#9001, "value"), verb_info(#9001, "test")};
{{#3, "rc"}, {#3, "rxd", "test"}}

// Explicit dry_run and selective overrides must also remain read-only.
; const result = load_object(#0.dry_run_source, ["dry_run" -> true, "return_conflicts" -> true, "overrides" -> {{#9001, "object_flags"}}]); return {!result[1], length(result[2]) > 0};
{1, 1}

; return {#9001.value, #9001.wizard, object_metadata(#9001, "revision"), #9001:test()};
{7, 0, 1, 1}

// detect cannot be disabled by an explicit false dry_run option.
; const result = load_object(#0.dry_run_source, ["conflict_mode" -> "detect", "dry_run" -> false, "return_conflicts" -> false]); return {!result[1], length(result[2]) > 0};
{1, 1}

