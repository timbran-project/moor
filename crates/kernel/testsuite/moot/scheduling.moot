// Native scheduled tasks: schedule_at / schedule_every / schedule_stop /
// schedule_valid / schedule_info / schedules / schedules_for.

@wizard
// Argument validation.
; schedule_at(#1, "foo");
E_ARGS
; schedule_at("nope", "foo", time());
E_TYPE
; schedule_at(#1, "no_such_verb_anywhere", time());
E_INVARG
; schedule_every(#1, "foo", 0);
E_INVARG

// A schedule created and stopped inside one task never exists.
; target = create(#-1);
> add_verb(target, {player, "rxd", "tick"}, {"this", "none", "this"});
> set_verb_code(target, "tick", {"return 0;"});
> id = schedule_at(target, "tick", time() + 3600);
> a = schedule_valid(id);
> b = schedule_stop(id);
> c = schedule_valid(id);
> d = schedule_stop(id);
> recycle(target);
> return {a, b, c, d};
{true, true, false, false}

// schedule_stop on nonsense ids is a quiet false.
; return {schedule_stop(0), schedule_stop(-5), schedule_stop(2147483647), schedule_valid(2147483647)};
{false, false, false, false}

// Unknown option keys are caught at creation.
; target = create(#-1);
> add_verb(target, {player, "rxd", "tick"}, {"this", "none", "this"});
> set_verb_code(target, "tick", {"return 0;"});
> try
>   schedule_at(target, "tick", time() + 60, {}, ["typo" -> 1]);
>   r = "no error";
> except e (E_INVARG)
>   r = "E_INVARG";
> endtry
> recycle(target);
> return r;
"E_INVARG"

// Oversized state is rejected.
; target = create(#-1);
> add_verb(target, {player, "rxd", "tick"}, {"this", "none", "this"});
> set_verb_code(target, "tick", {"return 0;"});
> big = "";
> for i in [1..600] big = big + "0123456789"; endfor
> try
>   schedule_at(target, "tick", time() + 60, {}, ["state" -> big]);
>   r = "no error";
> except e (E_INVARG)
>   r = "E_INVARG";
> endtry
> recycle(target);
> return r;
"E_INVARG"

// Deadlines past the representable limit are rejected at creation, not
// armed: a huge interval, a huge absolute time, and a jitter too large for a
// duration. None of these may panic or reach the scheduler.
; target = create(#-1);
> add_verb(target, {player, "rxd", "tick"}, {"this", "none", "this"});
> set_verb_code(target, "tick", {"return 0;"});
> r = {};
> for c in ({{"every", 1e19, []}, {"every", 1e300, []}, {"at", 1e19, []}, {"at", 1e300, []}, {"every", 60, ["jitter" -> 1e300]}})
>   try
>     if (c[1] == "every")
>       schedule_every(target, "tick", c[2], {}, c[3]);
>     else
>       schedule_at(target, "tick", c[2], {}, c[3]);
>     endif
>     r = {@r, "no error"};
>   except e (E_INVARG)
>     r = {@r, "E_INVARG"};
>   endtry
> endfor
> recycle(target);
> return r;
{"E_INVARG", "E_INVARG", "E_INVARG", "E_INVARG", "E_INVARG"}

// A one-shot fires: the verb records its args (pass_elapsed appends a float),
// and afterwards the schedule is retired but still inspectable.
; target = create(#-1);
> add_property(target, "hits", {}, {player, "rw"});
> add_verb(target, {player, "rxd", "tick"}, {"this", "none", "this"});
> set_verb_code(target, "tick", {"this.hits = {@this.hits, args}; return 0;"});
> id = schedule_at(target, "tick", ftime(), {"a", 2});
> commit();
> suspend(0.5);
> info = schedule_info(id);
> hits = target.hits;
> recycle(target);
> return {length(hits), hits[1][1], hits[1][2], typeof(hits[1][3]), info["run_count"], info["retired"], info["retire_reason"], info["kind"], schedule_valid(id)};
{1, "a", 2, TYPE_FLOAT, 1, true, "returned_zero", "at", false}

// Stopping a retired schedule is a stale-id false, and releases its
// diagnostics: schedule_info then fails like any unknown id.
; target = create(#-1);
> add_verb(target, {player, "rxd", "tick"}, {"this", "none", "this"});
> set_verb_code(target, "tick", {"return 0;"});
> id = schedule_at(target, "tick", ftime());
> commit();
> suspend(0.5);
> was_retired = schedule_info(id)["retired"];
> stopped = schedule_stop(id);
> commit();
> try
>   schedule_info(id);
>   after = "still there";
> except e (E_INVARG)
>   after = "E_INVARG";
> endtry
> recycle(target);
> return {was_retired, stopped, after};
{true, false, "E_INVARG"}

// The adaptive protocol: a one-shot that returns a positive number re-arms.
; target = create(#-1);
> add_property(target, "n", 0, {player, "rw"});
> add_verb(target, {player, "rxd", "tick"}, {"this", "none", "this"});
> set_verb_code(target, "tick", {"this.n = this.n + 1; return this.n < 3 ? 0.05 | 0;"});
> id = schedule_at(target, "tick", ftime(), {}, ["pass_elapsed" -> 0]);
> commit();
> suspend(1.0);
> n = target.n;
> info = schedule_info(id);
> recycle(target);
> return {n, info["run_count"], info["retired"]};
{3, 3, true}

// schedule_every fires repeatedly, passes elapsed, and stops on demand.
; target = create(#-1);
> add_property(target, "n", 0, {player, "rw"});
> add_verb(target, {player, "rxd", "tick"}, {"this", "none", "this"});
> set_verb_code(target, "tick", {"this.n = this.n + 1; return 0;"});
> id = schedule_every(target, "tick", 0.1);
> commit();
> suspend(0.75);
> before = target.n;
> schedule_stop(id);
> commit();
> suspend(0.3);
> after = target.n;
> recycle(target);
> return {before >= 3, after == before || after == before + 1, schedule_valid(id)};
{1, 1, false}

// A faulting verb does not kill the schedule; max_faults retires it.
; target = create(#-1);
> add_verb(target, {player, "rxd", "tick"}, {"this", "none", "this"});
> set_verb_code(target, "tick", {"return 1 / 0;"});
> id = schedule_every(target, "tick", 0.05, {}, ["max_faults" -> 2]);
> commit();
> suspend(0.6);
> info = schedule_info(id);
> recycle(target);
> return {info["fault_count"] >= 2, info["consecutive_faults"] >= 2, info["retired"], info["retire_reason"]};
{1, 1, true, "max_faults"}

// Overlap policies, with a verb that runs longer than its interval. `live`
// counts firings in progress and `peak` is its high-water mark.
// skip: later deadlines are dropped while one firing runs.
; target = create(#-1);
> add_property(target, "live", 0, {player, "rw"});
> add_property(target, "peak", 0, {player, "rw"});
> add_verb(target, {player, "rxd", "slow"}, {"this", "none", "this"});
> set_verb_code(target, "slow", {"this.live = this.live + 1; this.peak = max(this.peak, this.live); suspend(0.5); this.live = this.live - 1;"});
> id = schedule_every(target, "slow", 0.2, {}, ["pass_elapsed" -> 0]);
> commit();
> suspend(1.0);
> schedule_stop(id);
> info = schedule_info(id);
> commit();
> suspend(0.6);
> peak = target.peak;
> recycle(target);
> return {peak, info["overlap_count"] >= 2};
{1, 1}

// concurrent: a deadline that arrives mid-firing starts another task.
; target = create(#-1);
> add_property(target, "live", 0, {player, "rw"});
> add_property(target, "peak", 0, {player, "rw"});
> add_verb(target, {player, "rxd", "slow"}, {"this", "none", "this"});
> set_verb_code(target, "slow", {"this.live = this.live + 1; this.peak = max(this.peak, this.live); suspend(0.5); this.live = this.live - 1;"});
> id = schedule_every(target, "slow", 0.2, {}, ["pass_elapsed" -> 0, "overlap" -> "concurrent"]);
> commit();
> suspend(1.0);
> schedule_stop(id);
> info = schedule_info(id);
> commit();
> suspend(0.6);
> peak = target.peak;
> recycle(target);
> return {peak >= 2, info["overlap_count"]};
{1, 0}

// queue: a deadline that arrives mid-firing runs as soon as that firing
// ends, not at the next cadence point. The first firing (at 0.4s) runs
// for 0.5s across the 0.8s deadline; the queued firing starts at ~0.9s
// rather than 1.2s.
; target = create(#-1);
> add_property(target, "log", {}, {player, "rw"});
> add_verb(target, {player, "rxd", "slow"}, {"this", "none", "this"});
> set_verb_code(target, "slow", {"this.log = {@this.log, ftime()}; if (length(this.log) == 1) suspend(0.5); this.log = {@this.log, ftime()}; endif"});
> id = schedule_every(target, "slow", 0.4, {}, ["pass_elapsed" -> 0, "overlap" -> "queue"]);
> commit();
> suspend(1.05);
> schedule_stop(id);
> info = schedule_info(id);
> commit();
> log = target.log;
> recycle(target);
> return {length(log) >= 3, length(log) >= 3 && log[3] - log[2] < 0.15, info["overlap_count"]};
{1, 1, 0}

// schedules_for indexes by target; schedules() by owner; recycle leaves nothing behind.
; target = create(#-1);
> add_verb(target, {player, "rxd", "tick"}, {"this", "none", "this"});
> set_verb_code(target, "tick", {"return 0;"});
> a = schedule_at(target, "tick", time() + 3600);
> b = schedule_every(target, "tick", 3600);
> commit();
> mine = schedules();
> forit = schedules_for(target);
> info = schedule_info(b);
> schedule_stop(a); schedule_stop(b);
> commit();
> left = schedules_for(target);
> recycle(target);
> return {(a in mine) && (b in mine) && 1, forit == {a, b}, info["target"] == target, info["interval"], info["owner"] == player, left};
{1, 1, 1, 3600.0, 1, {}}

// schedule_info on an unknown id.
; schedule_info(2147483647);
E_INVARG

// A wizard-owned object with a method guarded by `caller == this`, for the
// programmer-side tests below.
; add_property($system, "sched_guarded", create($nothing), {player, "rwc"});
; add_property($sched_guarded, "poked", 0, {player, "rw"});
; add_verb($sched_guarded, {player, "rxd", "poke"}, {"this", "none", "this"});
; set_verb_code($sched_guarded, "poke", {"caller == this || raise(E_PERM); this.poked = 1; return 0;"});

@programmer
// A programmer sees only their own (none here).
; return schedules();
{}

// Scheduling authorizes like a method call: the verb must be executable by the
// caller, not readable. A wizard-owned verb with "x" but no "r" can be scheduled
// by a programmer and fires; one with "r" but no "x" cannot be scheduled.
// Clearing "x" after creation retires the schedule at firing time.
@wizard
; add_property(#0, "sched_perm", create(#-1), {player, "r"});
; add_property($sched_perm, "n", 0, {player, "r"});
; add_verb($sched_perm, {player, "x", "tick"}, {"this", "none", "this"});
; set_verb_code($sched_perm, "tick", {"this.n = this.n + 1; return 0;"});
; add_verb($sched_perm, {player, "r", "peek"}, {"this", "none", "this"});
; set_verb_code($sched_perm, "peek", {"return 0;"});
; add_verb($sched_perm, {player, "x", "later"}, {"this", "none", "this"});
; set_verb_code($sched_perm, "later", {"this.n = this.n + 100; return 0;"});
@programmer
; return $sched_perm:tick() == 0 && $sched_perm.n;
1
; schedule_at($sched_perm, "peek", time() + 60, {}, ["player" -> player]);
E_INVARG
; add_property(player, "sched_later", 0, {player, "rw"});
; id = schedule_at($sched_perm, "tick", ftime(), {}, ["player" -> player]);
> player.sched_later = schedule_at($sched_perm, "later", ftime() + 1.0, {}, ["player" -> player]);
> commit();
> suspend(0.3);
> info = schedule_info(id);
> return {$sched_perm.n, info["run_count"], info["retire_reason"]};
{2, 1, "returned_zero"}
@wizard
; set_verb_info($sched_perm, "later", {player, "r", "later"});
@programmer
; suspend(1.2);
> info = schedule_info(player.sched_later);
> return {$sched_perm.n, info["run_count"], info["retire_reason"]};
{2, 0, "invalid_target"}
; delete_property(player, "sched_later");
@wizard
; recycle($sched_perm);
; delete_property(#0, "sched_perm");

@programmer
// The fired verb sees the creator as `caller` and `caller_perms()`, and the
// target as `player`.
; target = create($nothing);
> add_property(target, "seen", 0, {player, "rw"});
> add_verb(target, {player, "rxd", "probe"}, {"this", "none", "this"});
> set_verb_code(target, "probe", {"this.seen = {caller, caller_perms(), player}; return 0;"});
> schedule_at(target, "probe", ftime(), {}, ["pass_elapsed" -> 0]);
> commit();
> suspend(0.5);
> seen = target.seen;
> recycle(target);
> return seen == {player, player, target};
1

// A programmer cannot make `player` an object they do not control, either
// explicitly or through the target default.
; schedule_at($sched_guarded, "poke", ftime());
E_PERM
; schedule_at($sched_guarded, "poke", ftime(), {}, ["player" -> $wizard_player]);
E_PERM

// With `player` set to themselves, the call goes through but `caller` is the
// creator, so a `caller == this` guard still refuses it.
; id = schedule_at($sched_guarded, "poke", ftime(), {}, ["player" -> player, "pass_elapsed" -> 0]);
> commit();
> suspend(0.5);
> info = schedule_info(id);
> return {$sched_guarded.poked, info["fault_count"], info["player"] == player};
{0, 1, 1}
