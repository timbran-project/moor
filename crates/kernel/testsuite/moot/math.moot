// Adapted from https://github.com/toddsundsted/stunt/blob/a4158f5835f1beb9d754c92fd5b3a137e459aabf/test/test_math.rb
@programmer

// test_that_random_0_is_invalid
; random(0);
E_INVARG

; random(42.123);
E_TYPE

// test_that_random_1_returns_1
; return random(1);
1

// test_that_random_returns_a_number_between_1_and_i64::MAX
; for i in [1..1000]; n = random(); if (n <= 0 || n > 9223372036854775807); return "FAIL"; endif; endfor; return "PASS";
"PASS"

// test_that_random_requires_a_positive_integer
; random(-3);
E_INVARG

// more than 1 argument is invalid
; random(1, 2, 3);
E_ARGS

// test_that_division_by_zero_fails
; return 1.1 / 0.0;
E_DIV
; 1 / 0;
E_DIV
; 1.1 % 0.0;
E_DIV
; 1 % 0;
E_DIV

// test_the_minint_edge_case
// Note: LambdaMOO 1.8.1 crashes and burns (core dumped) on this first case
// The result in Toast seems nonsensical (-2147483648 / -1 => -2147483648)
// Sooo let's just... do the right thing here.
; return -2147483648 / -1;
2147483648
; return -2147483648 % -1;
0
// i64::MIN
; return -9223372036854775808;
-9223372036854775808
; return -9223372036854775807 / -1;
9223372036854775807
; return -9223372036854775807 % -1;
0
; return -9223372036854775808 / -1;
E_INVARG
; return -9223372036854775808 % -1;
E_INVARG

// test_division
// ints
; return -15 / -3;
5
; return -15 / 3;
-5
; return 15 / -3;
-5
; return 15 / 3;
5
// floats
; return -15.0 / -3.0;
5.0
; return -15.0 / 3.0;
-5.0
; return 15.0 / -3.0;
-5.0
; return 15.0 / 3.0;
5.0

// test_modulus
// ints
; return -15 % -4;
-3
; return -15 % 4;
-3
; return 15 % -4;
3
; return 15 % 4;
3
// floats
; return -15.0 % -4.0;
-3.0
; return -15.0 % 4.0;
-3.0
; return 15.0 % -4.0;
3.0
; return 15.0 % 4.0;
3.0

// test_round_to_integer
; return round(3.5);
4.0
; return round(3.4);
3.0
; return round(-3.5);
-4.0
; return round(-3.4);
-3.0

// test_round_with_places
; return round(3.14159, 2);
3.14
; return round(3.14159, 4);
3.1416
; return round(2.5555, 3);
2.556
; return round(-2.5555, 2);
-2.56

// test_round_accepts_int_input
; return round(5);
5.0
; return round(5, 2);
5.0

// test_round_with_zero_places
; return round(3.7, 0);
4.0

// test_round_with_negative_places
; return round(12345.6, -2);
12300.0

// test_round_errors
; round();
E_ARGS
; round(1.0, 2, 3);
E_ARGS
; round(1.0, "bad");
E_TYPE

// LambdaMOO: IEEE infinities and NaNs are not allowed in MOO; E_FLOAT is raised
// wherever one would otherwise be computed.
; 1e308 + 1e308;
E_FLOAT

; 1e308 * 10.0;
E_FLOAT

; 1e308 / 1.0e-308;
E_FLOAT

; 2.0 ^ 2000.0;
E_FLOAT

; 0.0 ^ -1.0;
E_FLOAT

; (-8.0) ^ 0.5;
E_FLOAT

; exp(1000.0);
E_FLOAT

; cosh(1000.0);
E_FLOAT

// Domain errors raise E_INVARG, including at the poles of atanh()
; sqrt(-1.0);
E_INVARG

; atanh(1.0);
E_INVARG

; atanh(-1.0);
E_INVARG

// round() must not misreport scaling overflow as a math error
; return round(0.0, 400);
0.0

; return round(2.5, 400);
2.5

; return round(2.5, 2147483648);
2.5

; return round(1e300, 20);
1e300

; return round(1.5, -400);
0.0

// Integer exponents keep exact parity beyond 2^53
; return (-1.0) ^ 9007199254740993;
-1.0

; asin(2.0);
E_INVARG

; log(-1.0);
E_INVARG

// Integer powers with negative exponents follow LambdaMOO
; return 2 ^ -3;
0

; return (-1) ^ -3;
-1

; return 1 ^ -500;
1

; 0 ^ -1;
E_DIV