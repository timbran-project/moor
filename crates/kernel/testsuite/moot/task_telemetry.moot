@wizard
; telemetry = task_telemetry(task_id()); return typeof(telemetry) == TYPE_MAP && telemetry["task_id"] == task_id() && telemetry["player"] == player && telemetry["phase"] == 'running && telemetry["worker_index"] >= 0 && telemetry["dispatch_wait_ns"] >= 0 && telemetry["running_ns"] >= 0;
1

; for telemetry in (task_telemetry()) if (telemetry["task_id"] == task_id()) return 1; endif endfor return 0;
1

