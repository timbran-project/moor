// Public test-only SSH keys. Never use these fixtures for real data.

@programmer

// SSH-RSA recipient and binary identity round trip
; public = "ssh-rsa ";
> private = b"";
> encrypted = age_encrypt("SSH RSA fixture", {public});
> return age_decrypt(encrypted, {private}) == "SSH RSA fixture";
1

// SSH-Ed25519 recipient and binary identity round trip
; public = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDsQF8bhba6kYeSkKFKaXfBS4JTUq7GX6pRVhhJuF9NC";
> private = b"";
> encrypted = age_encrypt("SSH Ed25519 fixture", {public});
> return age_decrypt(encrypted, {private}) == "SSH Ed25519 fixture";
1

