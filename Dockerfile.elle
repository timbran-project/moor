# Dockerfile for Elle consistency testing
# Builds Elle model checkers, installs elle-cli, runs workload, and checks consistency

FROM rust:1.98.1-bookworm AS builder

# Build all Elle model checker binaries from the workspace
WORKDIR /build
COPY . /build
RUN cargo build --release --bin list-append

# Runtime stage with JVM for elle-cli. CI checks with Java 21 and elle-cli at the same commit.
FROM eclipse-temurin:21-jdk-noble

ARG ELLE_CLI_COMMIT=65fafcfa939cced8b7d279db1b2a666929885e65

# Install Leiningen and dependencies
RUN apt-get update && \
    apt-get install -y \
    git \
    graphviz \
    leiningen \
    && rm -rf /var/lib/apt/lists/*

# Fetch and build elle-cli at the pinned commit
RUN git init /opt/elle-cli && \
    cd /opt/elle-cli && \
    git remote add origin https://github.com/ligurio/elle-cli.git && \
    git fetch --depth 1 origin "$ELLE_CLI_COMMIT" && \
    git checkout --detach FETCH_HEAD && \
    lein deps && \
    lein uberjar && \
    ln -s "$(find target -maxdepth 1 -name '*-standalone.jar' -print -quit)" /opt/elle-cli/elle-cli.jar

# Copy the built binaries from builder stage
COPY --from=builder /build/target/release/list-append /usr/local/bin/

# Copy analysis script
COPY crates/testing/load-tools/analyze-elle-failure.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/analyze-elle-failure.sh

# Create output directory
RUN mkdir -p /output

WORKDIR /output

# Default command: run the list-append workload and check it with Elle.
# Direct database access - no scheduler overhead
CMD list-append \
      --target ${TARGET:-db} \
      --num-active-keys ${NUM_ACTIVE_KEYS:-10} \
      --num-concurrent-workloads ${NUM_CONCURRENT:-16} \
      --num-workload-iterations ${NUM_ITERATIONS:-2000} \
      --output-file /output/workload.edn && \
    analyze-elle-failure.sh /output/workload.edn
