USER_ID=1000
GROUP_ID=1000
# The mooR release to run, which is the container image tag. The default is the latest release.
# MOOR_VERSION=2.0.0
# The address the published ports listen on. The default is every address. Use 127.0.0.1 to
# reach the server only from the machine itself.
# MOOR_BIND=127.0.0.1
# The core a new world starts from: a directory under cores/. snore is a classic MOO core, and
# cowbell is the one built for the web client. Only read when the database is first made.
# MOOR_CORE=cowbell
