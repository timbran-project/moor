usdt:*:moor_v1:diagnostics_attached
{
    @diagnostics_heartbeat = nsecs;
}

usdt:*:moor_v1:verb_metadata
{
    @verb_names[(uint64)arg0, (uint64)arg1, (uint64)arg2] =
        str(uptr((uint8 *)arg3));
    @verb_name_lengths[(uint64)arg0, (uint64)arg1, (uint64)arg2] =
        (uint64)arg4;
}

usdt:*:moor_v1:verb_metadata_done
{
    @verb_metadata_generation++;
    @verb_metadata_status = ((uint64)arg0, (uint64)arg1);
}

/*
 * Each execution-state entry has one slot per thread. Verb spans and builtin
 * spans of the same kind must not nest on one thread. The VM returns to the
 * task loop before another span of either kind starts.
 */

usdt:*:moor_v1:task_run_start
{
    @active[cpu, 0]++;
    @task_state[tid] = (
        nsecs,
        (uint64)arg0,
        (uint64)arg1,
        (uint64)arg2,
        (uint64)arg3
    );
}

usdt:*:moor_v1:task_run_done
{
    $state = @task_state[tid];
    if ($state.0 != (uint64)0) {
        $cpu = cpu;
        @active[$cpu, 0]--;
        $elapsed = nsecs - $state.0;
        @task_count[$cpu, $state.2, $state.3, $state.4]++;
        @task_total[$cpu, $state.2, $state.3, $state.4] += $elapsed;
        @task_hist[$cpu, $state.2, $state.3, $state.4] = hist($elapsed);
        delete(@task_state[tid]);
    }
}

usdt:*:moor_v1:verb_run_start
{
    @active[cpu, 2]++;
    @verb_state[tid] = (
        nsecs,
        (uint64)arg0,
        (uint64)arg1,
        (uint64)arg2,
        (uint64)arg3
    );
}

usdt:*:moor_v1:verb_run_done
{
    $state = @verb_state[tid];
    if ($state.0 != (uint64)0) {
        $cpu = cpu;
        @active[$cpu, 2]--;
        $elapsed = nsecs - $state.0;
        @verb_count[$cpu, $state.2, $state.3, $state.4]++;
        @verb_total[$cpu, $state.2, $state.3, $state.4] += $elapsed;
        @verb_hist[$cpu, $state.2, $state.3, $state.4] = hist($elapsed);
        delete(@verb_state[tid]);
    }
}

usdt:*:moor_v1:builtin_run_start
{
    @active[cpu, 3]++;
    @builtin_state[tid] = (nsecs, (uint64)arg0, (uint64)arg1);
}

usdt:*:moor_v1:builtin_run_done
{
    $state = @builtin_state[tid];
    if ($state.0 != (uint64)0) {
        $cpu = cpu;
        @active[$cpu, 3]--;
        $elapsed = nsecs - $state.0;
        @builtin_count[$cpu, $state.2]++;
        @builtin_total[$cpu, $state.2] += $elapsed;
        @builtin_hist[$cpu, $state.2] = hist($elapsed);
        delete(@builtin_state[tid]);
    }
}

usdt:*:moor_v1:task_commit_start
{
    @active[cpu, 4]++;
    @stage_start[tid, 0] = nsecs;
}

usdt:*:moor_v1:task_commit_done
{
    $cpu = cpu;
    $outcome = (uint64)arg1;
    @stage_outcome[$cpu, 0, $outcome]++;
    if (@stage_start[tid, 0] != (uint64)0) {
        @active[$cpu, 4]--;
        $elapsed = nsecs - @stage_start[tid, 0];
        @stage_count[$cpu, 0]++;
        @stage_total[$cpu, 0] += $elapsed;
        @stage_hist[$cpu, 0] = hist($elapsed);
        delete(@stage_start[tid, 0]);
    }
}

/*
 * Activation kind 0 is a real verb call. Task ID and stack depth match calls
 * across suspension and worker migration.
 */
usdt:*:moor_v1:moo_activation_start
{
    $cpu = cpu;
    $task_id = (uint64)arg0;
    $depth = (uint64)arg1;
    $kind = arg2;
    $uuid_high = (uint64)arg3;
    $uuid_low = (uint64)arg4;
    $definer = (uint64)arg5;
    @moo_activation_state[$task_id, $depth] = (
        nsecs,
        $kind,
        $uuid_high,
        $uuid_low,
        $definer
    );
    if ($kind == 0) {
        @active[$cpu, 1]++;
        @verb_call_started[$cpu, $uuid_high, $uuid_low, $definer]++;
    }
}

usdt:*:moor_v1:moo_activation_done
{
    $task_id = (uint64)arg0;
    $depth = (uint64)arg1;
    $state = @moo_activation_state[$task_id, $depth];
    if ($state.0 != (uint64)0) {
        if ($state.1 == 0) {
            $cpu = cpu;
            @active[$cpu, 1]--;
            $elapsed = nsecs - $state.0;
            @verb_call_count[$cpu, $state.2, $state.3, $state.4]++;
            @verb_call_total[$cpu, $state.2, $state.3, $state.4] += $elapsed;
            @verb_call_hist[$cpu, $state.2, $state.3, $state.4] = hist($elapsed);
        }
        delete(@moo_activation_state[$task_id, $depth]);
    }
}

