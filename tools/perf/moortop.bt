interval:s:$1
{
    $now = nsecs;
    printf("MOORTOP_BEGIN %llu\n", $now);
    print(@task_count);
    print(@task_total);
    print(@task_hist);
    print(@verb_call_started);
    print(@verb_call_count);
    print(@verb_call_total);
    print(@verb_call_hist);
    print(@verb_count);
    print(@verb_total);
    print(@verb_hist);
    print(@builtin_count);
    print(@builtin_total);
    print(@builtin_hist);
    print(@stage_count);
    print(@stage_total);
    print(@stage_hist);
    print(@stage_outcome);
    print(@active);
    if (@verb_metadata_generation != @verb_metadata_printed_generation) {
        print(@verb_names);
        print(@verb_name_lengths);
        print(@verb_metadata_generation);
        print(@verb_metadata_status);
        @verb_metadata_printed_generation = @verb_metadata_generation;
    }
    printf("MOORTOP_END %llu\n", $now);
    if ($2 != 0) {
        exit();
    }
}
