BEGIN
{
    @capture_start = nsecs;
}

usdt:*:moor_v1:task_run_start
{
    @task_state[tid] = (
        nsecs,
        (uint64)arg0,
        (uint64)arg1,
        (uint64)arg2,
        (uint64)arg3
    );
    if ((uint64)arg4 != 0 &&
        @verb_name_seen[(uint64)arg1, (uint64)arg2, (uint64)arg3, (uint64)arg4] == 0) {
        @verb_names[(uint64)arg1, (uint64)arg2, (uint64)arg3, (uint64)arg4] =
            str(uptr((uint8 *)arg4), (uint32)arg5);
        @verb_name_seen[(uint64)arg1, (uint64)arg2, (uint64)arg3, (uint64)arg4] = 1;
    }
}

usdt:*:moor_v1:task_run_done
{
    $state = @task_state[tid];
    if ($state.0 != 0) {
        $cpu = cpu;
        $elapsed = nsecs - $state.0;
        @task_count[$cpu, $state.1, $state.2, $state.3, $state.4]++;
        @task_total[$cpu, $state.1, $state.2, $state.3, $state.4] += $elapsed;
        if ($elapsed > @task_max[$cpu, $state.1, $state.2, $state.3, $state.4]) {
            @task_max[$cpu, $state.1, $state.2, $state.3, $state.4] = $elapsed;
        }
        @task_hist[$cpu, $state.1, $state.2, $state.3, $state.4] = hist($elapsed, 3);
        delete(@task_state[tid]);
    } else {
        @unmatched[cpu, 100]++;
    }
}

usdt:*:moor_v1:task_commit_start
{
    @stage_start[tid, 0] = nsecs;
}

usdt:*:moor_v1:task_commit_done
{
    $cpu = cpu;
    @stage_outcome[$cpu, 0, 0]++;
    if (@stage_start[tid, 0] != 0) {
        $elapsed = nsecs - @stage_start[tid, 0];
        @stage_count[$cpu, 0]++;
        @stage_total[$cpu, 0] += $elapsed;
        if ($elapsed > @stage_max[$cpu, 0]) {
            @stage_max[$cpu, 0] = $elapsed;
        }
        @stage_hist[$cpu, 0] = hist($elapsed, 3);
        delete(@stage_start[tid, 0]);
    } else {
        @unmatched[$cpu, 0]++;
    }
}

usdt:*:moor_v1:verb_name
{
    if (@verb_name_seen[(uint64)arg0, (uint64)arg1, (uint64)arg2, (uint64)arg3] == 0) {
        @verb_names[(uint64)arg0, (uint64)arg1, (uint64)arg2, (uint64)arg3] =
            str(uptr((uint8 *)arg3), (uint32)arg4);
        @verb_name_seen[(uint64)arg0, (uint64)arg1, (uint64)arg2, (uint64)arg3] = 1;
    }
}

usdt:*:moor_v1:verb_run_start
{
    @verb_state[tid] = (
        nsecs,
        (uint64)arg0,
        (uint64)arg1,
        (uint64)arg2,
        (uint64)arg3,
        (uint64)arg4,
        (uint64)arg5
    );
}

usdt:*:moor_v1:verb_run_done
{
    $state = @verb_state[tid];
    if ($state.0 != 0) {
        $cpu = cpu;
        $elapsed = nsecs - $state.0;
        @verb_count[$cpu, $state.2, $state.3, $state.4]++;
        @verb_total[$cpu, $state.2, $state.3, $state.4] += $elapsed;
        if ($elapsed > @verb_max[$cpu, $state.2, $state.3, $state.4]) {
            @verb_max[$cpu, $state.2, $state.3, $state.4] = $elapsed;
        }
        @verb_hist[$cpu, $state.2, $state.3, $state.4] = hist($elapsed, 3);
        delete(@verb_state[tid]);
    } else {
        @unmatched[cpu, 101]++;
    }
}

profile:hz:$3
/pid == $2 && @verb_state[tid].6 != 0/
{
    $state = @verb_state[tid];
    $pc = *uptr((uint16 *)$state.6);
    @pc_samples[cpu, $state.2, $state.3, $state.4, $pc]++;
}

