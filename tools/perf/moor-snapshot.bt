BEGIN
{
    @capture_start = nsecs;
}

/*
 * Each execution-state entry has one slot per thread. Verb spans and builtin
 * spans of the same kind must not nest on one thread. The VM returns to the
 * task loop before another span of either kind starts.
 */

usdt:*:moor_v1:task_run_start
{
    @task_state[tid] = (
        nsecs,
        (uint64)arg0,
        (uint64)arg1,
        (uint64)arg2,
        (uint64)arg3
    );
}

usdt:*:moor_v1:task_run_done
{
    $state = @task_state[tid];
    if ($state.0 != (uint64)0) {
        $cpu = cpu;
        $elapsed = nsecs - $state.0;
        @task_count[$cpu, $state.1, $state.2, $state.3, $state.4]++;
        @task_total[$cpu, $state.1, $state.2, $state.3, $state.4] += $elapsed;
        if ($elapsed > @task_max[$cpu, $state.1, $state.2, $state.3, $state.4]) {
            @task_max[$cpu, $state.1, $state.2, $state.3, $state.4] = $elapsed;
        }
        @task_hist[$cpu, $state.1, $state.2, $state.3, $state.4] = hist($elapsed);
        delete(@task_state[tid]);
    } else {
        @unmatched[cpu, 100]++;
    }
}

usdt:*:moor_v1:task_commit_start
{
    @stage_start[tid, 0] = nsecs;
}

usdt:*:moor_v1:task_commit_done
{
    $cpu = cpu;
    $outcome = (uint64)arg1;
    @stage_outcome[$cpu, 0, $outcome]++;
    if (@stage_start[tid, 0] != (uint64)0) {
        $elapsed = nsecs - @stage_start[tid, 0];
        @stage_count[$cpu, 0]++;
        @stage_total[$cpu, 0] += $elapsed;
        if ($elapsed > @stage_max[$cpu, 0]) {
            @stage_max[$cpu, 0] = $elapsed;
        }
        @stage_hist[$cpu, 0] = hist($elapsed);
        delete(@stage_start[tid, 0]);
    } else {
        @unmatched[$cpu, 0]++;
    }
}

/*
 * Activation kind 0 is a real verb call. Task ID and stack depth match calls
 * across suspension and worker migration.
 */
usdt:*:moor_v1:moo_activation_start
/arg2 == 0/
{
    $cpu = cpu;
    $task_id = (uint64)arg0;
    $depth = (uint64)arg1;
    $uuid_high = (uint64)arg3;
    $uuid_low = (uint64)arg4;
    $definer = (uint64)arg5;
    @verb_call_started[$cpu, $uuid_high, $uuid_low, $definer]++;
    @verb_call_state[$task_id, $depth] = (
        nsecs,
        $uuid_high,
        $uuid_low,
        $definer
    );
}

usdt:*:moor_v1:moo_activation_done
{
    $task_id = (uint64)arg0;
    $depth = (uint64)arg1;
    $state = @verb_call_state[$task_id, $depth];
    if ($state.0 != (uint64)0) {
        $cpu = cpu;
        $elapsed = nsecs - $state.0;
        @verb_call_count[$cpu, $state.1, $state.2, $state.3]++;
        @verb_call_total[$cpu, $state.1, $state.2, $state.3] += $elapsed;
        if ($elapsed > @verb_call_max[$cpu, $state.1, $state.2, $state.3]) {
            @verb_call_max[$cpu, $state.1, $state.2, $state.3] = $elapsed;
        }
        @verb_call_hist[$cpu, $state.1, $state.2, $state.3] = hist($elapsed);
        delete(@verb_call_state[$task_id, $depth]);
    }
}

usdt:*:moor_v1:verb_run_start
{
    @verb_state[tid] = (
        nsecs,
        (uint64)arg0,
        (uint64)arg1,
        (uint64)arg2,
        (uint64)arg3,
        (uint64)arg4,
        (uint64)arg5
    );
}

usdt:*:moor_v1:verb_run_done
{
    $state = @verb_state[tid];
    if ($state.0 != (uint64)0) {
        $cpu = cpu;
        $elapsed = nsecs - $state.0;
        @verb_count[$cpu, $state.2, $state.3, $state.4]++;
        @verb_total[$cpu, $state.2, $state.3, $state.4] += $elapsed;
        if ($elapsed > @verb_max[$cpu, $state.2, $state.3, $state.4]) {
            @verb_max[$cpu, $state.2, $state.3, $state.4] = $elapsed;
        }
        @verb_hist[$cpu, $state.2, $state.3, $state.4] = hist($elapsed);
        delete(@verb_state[tid]);
    } else {
        @unmatched[cpu, 101]++;
    }
}

usdt:*:moor_v1:builtin_run_start
{
    $builtin_id = (uint64)arg1;
    @builtin_state[tid] = (nsecs, (uint64)arg0, $builtin_id);
}

usdt:*:moor_v1:builtin_run_done
{
    $state = @builtin_state[tid];
    if ($state.0 != (uint64)0) {
        $cpu = cpu;
        $elapsed = nsecs - $state.0;
        @builtin_count[$cpu, $state.2]++;
        @builtin_total[$cpu, $state.2] += $elapsed;
        if ($elapsed > @builtin_max[$cpu, $state.2]) {
            @builtin_max[$cpu, $state.2] = $elapsed;
        }
        @builtin_hist[$cpu, $state.2] = hist($elapsed);
        delete(@builtin_state[tid]);
    } else {
        @unmatched[cpu, 102]++;
    }
}

profile:hz:$3
/pid == (uint32)$2 && @verb_state[tid].6 != (uint64)0/
{
    $state = @verb_state[tid];
    $pc = *uptr((uint16 *)$state.6);
    @pc_samples[cpu, $state.2, $state.3, $state.4, $pc]++;
}

